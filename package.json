{
  "name": "heroui-v2-mcp",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "MCP server for HeroUI v2 (https://v2.heroui.com) component documentation, source code, styles and theme tokens.",
  "main": "dist/server.js",
  "bin": {
    "heroui-v2-mcp": "dist/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx --watch src/server.ts",
    "build": "tsup src/server.ts --format esm --target node22 --clean --out-dir dist && chmod +x dist/server.js",
    "start": "node dist/server.js",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true
  }
}
